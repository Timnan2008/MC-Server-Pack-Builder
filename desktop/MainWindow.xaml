<Window x:Class="McServerPackBuilder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="MC 服务端整合包助手" Icon="Assets/network-core.ico" Width="1020" Height="690" MinWidth="780" MinHeight="540"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#F3F6FB" Foreground="#243247" FontFamily="Microsoft YaHei UI" FontSize="13"
        AllowDrop="True" PreviewDragEnter="Window_DragEnter" PreviewDragOver="Window_DragOver"
        DragLeave="Window_DragLeave" PreviewDrop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome xmlns="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" BorderBrush="#D9E3F0" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/network-core.png" Width="30" Height="30" Stretch="Uniform"/>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MC 工坊" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="SERVER PACK BUILDER" FontSize="9" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="WorkbenchNavButton" Content="◫  工作台" Click="WorkbenchNav_Click" Style="{StaticResource TopNavButton}" Tag="Active"/>
                    <Button x:Name="ResultsNavButton" Content="☷  扫描结果" Click="ResultsNav_Click" Style="{StaticResource TopNavButton}"/>
                    <Border Width="1" Height="20" Background="#D9E3F0" Margin="12,0"/>
                    <TextBlock Text="模组管理  ·  即将推出" Foreground="#9CAABD" VerticalAlignment="Center" FontSize="11" Margin="7,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="─" Click="Minimize_Click" Style="{StaticResource WindowButton}" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Content="□" Click="Maximize_Click" Style="{StaticResource WindowButton}" ToolTip="最大化"/>
                    <Button Content="✕" Click="Close_Click" Style="{StaticResource CloseButton}" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="30,22,30,25">
                <!-- Header -->
                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="WORKSPACE  /  MC SERVER PACK BUILDER" Foreground="{StaticResource EmeraldBrush}" FontFamily="Consolas" FontSize="10" Margin="1,0,0,7"/>
                        <TextBlock x:Name="PageTitle" Text="整合包工作台" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="PageSubtitle" Text="导入客户端整合包，检查模组，一键生成服务端 ZIP" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button x:Name="CancelBuildButton" Content="取消制作" Click="CancelBuild_Click" Style="{StaticResource GameButton}" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Border Style="{StaticResource ChipStyle}" Background="#EAF3FD" VerticalAlignment="Center">
                            <TextBlock Text="◆  DESKTOP  /  LOCAL" Foreground="{StaticResource EmeraldBrush}" FontFamily="Consolas" FontSize="10"/></Border>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="WorkbenchPanel">
                <!-- Import -->
                <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="01" Style="{StaticResource StepNumber}"/>
                            <TextBlock Text="导入文件" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="  /  IMPORT PACK" Style="{StaticResource MutedText}" FontFamily="Consolas" VerticalAlignment="Center"/></StackPanel>
                        <Border x:Name="DropZone" Background="#F4F9FE" CornerRadius="12" Padding="1">
                            <Grid>
                                <Rectangle RadiusX="12" RadiusY="12" Stroke="#9FC3E9" StrokeThickness="1.5" StrokeDashArray="5,4" IsHitTestVisible="False"/>
                                <Grid Margin="17,13"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="#D9EBFC" BorderBrush="#A7C9EB" BorderThickness="1" VerticalAlignment="Top">
                                        <Grid><TextBlock Text="↑" FontSize="29" FontWeight="Bold" Foreground="{StaticResource DiamondBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,14,0">
                                        <TextBlock Text="拖拽整合包到这里" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="支持 .mrpack / .zip，也可扫描 JAR 或 mods 文件夹" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button x:Name="ChooseFileButton" Content="选择文件" Click="ChooseFile_Click" Style="{StaticResource PrimaryButton}"/>
                                        <Button x:Name="ChooseFolderButton" Content="选择文件夹" Click="ChooseFolder_Click" Style="{StaticResource GameButton}" Margin="8,0,0,0"/></StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource PathInput}" Height="40" VerticalContentAlignment="Center" TextChanged="PathBox_TextChanged" ToolTip="本地文件或文件夹路径"/>
                            <TextBlock Grid.Column="1" Text="本地路径" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"/>
                        </Grid>
                        <Border Background="#F1F7FD" BorderBrush="#D5E4F3" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,12,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="◆" Foreground="{StaticResource DiamondBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="InputStatus" Text="尚未选择内容" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" FontSize="12"/>
                                    <WrapPanel x:Name="InputBadges" Margin="0,7,0,0" Visibility="Collapsed">
                                        <Border Style="{StaticResource ChipStyle}"><TextBlock x:Name="PackTypeBadge" Foreground="{StaticResource DiamondBrush}" FontSize="11"/></Border>
                                        <Border x:Name="LoaderBadgeBox" Style="{StaticResource ChipStyle}" Background="#E8F1FB"><TextBlock x:Name="LoaderBadge" Foreground="{StaticResource EmeraldBrush}" FontSize="11"/></Border>
                                        <Border x:Name="VersionBadgeBox" Style="{StaticResource ChipStyle}" Background="#403B29"><TextBlock x:Name="VersionBadge" Foreground="{StaticResource GoldBrush}" FontSize="11"/></Border>
                                    </WrapPanel></StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="02" Style="{StaticResource StepNumber}"/><TextBlock Text="扫描与制作" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="  /  SCAN &amp; BUILD" Style="{StaticResource MutedText}" FontFamily="Consolas" VerticalAlignment="Center"/></StackPanel>
                        <WrapPanel Margin="25,12,0,0">
                            <Button x:Name="ScanButton" Content="⚡  开始扫描" Click="Scan_Click" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,2,8,2"/>
                            <Button x:Name="BuildButton" Content="制作服务端 ZIP" Click="Build_Click" Style="{StaticResource GameButton}" IsEnabled="False" Margin="0,2,8,2"/>
                            <Button x:Name="ExportButton" Content="导出 JSON" Click="Export_Click" Style="{StaticResource GameButton}" IsEnabled="False" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="17,13" Margin="0,0,0,14">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><TextBlock x:Name="StatusText" Text="等待导入" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="任务进度" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ActivityText" Text="选择一个文件以开始" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Grid.Column="1" Background="#EAF2FA" CornerRadius="6" Padding="2" BorderBrush="#BDD8F0" BorderThickness="1">
                                <ProgressBar x:Name="TaskProgress" Height="9" Minimum="0" Maximum="100" Value="0" Background="#DDEBFA" BorderThickness="0">
                                    <ProgressBar.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#3184DB" Offset="0"/><GradientStop Color="#6DB6EA" Offset="0.65"/><GradientStop Color="#A5DAF3" Offset="1"/></LinearGradientBrush></ProgressBar.Foreground>
                                </ProgressBar>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                <!-- Statistics -->
                <StackPanel Orientation="Horizontal" Margin="2,4,0,11"><TextBlock Text="03" Style="{StaticResource StepNumber}"/><TextBlock Text="数据概览" Style="{StaticResource SectionTitle}"/></StackPanel>
                <primitives:UniformGrid Columns="5" Rows="1" Margin="0,0,0,12">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="14"><StackPanel><TextBlock Text="总项数" Style="{StaticResource MutedText}"/><TextBlock x:Name="TotalCount" Text="—" Foreground="{StaticResource TextBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="3,0,6,0" Padding="14"><StackPanel><TextBlock Text="仅客户端" Style="{StaticResource MutedText}"/><TextBlock x:Name="ClientCount" Text="—" Foreground="{StaticResource RedstoneBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="3,0,6,0" Padding="14"><StackPanel><TextBlock Text="兼容服务端" Style="{StaticResource MutedText}"/><TextBlock x:Name="CompatibleCount" Text="—" Foreground="{StaticResource EmeraldBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="3,0,6,0" Padding="14"><StackPanel><TextBlock Text="建议保留" Style="{StaticResource MutedText}"/><TextBlock x:Name="KeepCount" Text="—" Foreground="{StaticResource DiamondBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="3,0,0,0" Padding="14"><StackPanel><TextBlock Text="待确认" Style="{StaticResource MutedText}"/><TextBlock x:Name="UnknownCount" Text="—" Foreground="{StaticResource GoldBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                </primitives:UniformGrid>
                <!-- Results -->
                <StackPanel Orientation="Horizontal" Margin="2,0,0,11"><TextBlock Text="04" Style="{StaticResource StepNumber}"/><TextBlock Text="扫描结果与明细" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="SummaryText" Text="  ·  暂无结果" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11" Margin="7,0,0,0"/></StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Style="{StaticResource PathInput}" Height="38" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center"
                                     ToolTip="按路径、判断依据或类别筛选"/>
                            <TextBlock Text="搜索模组路径、判断依据或类别…" Foreground="#97A7BB" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="ClearSearchButton" Grid.Column="1" Content="清除筛选" Style="{StaticResource GameButton}" Click="ClearSearch_Click" Margin="10,0,0,0" Padding="12,7" IsEnabled="False"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,12">
                    <Grid>
                    <DataGrid x:Name="ResultsGrid" Style="{StaticResource DarkGrid}" Height="300" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模组路径" Binding="{Binding Path}" Width="3*" MinWidth="160"/>
                            <DataGridTemplateColumn Header="服务端判断" Width="1.25*" MinWidth="115">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource SideBadge}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SideLabel}" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="依据" Binding="{Binding Reason}" Width="3*" MinWidth="170"/>
                            <DataGridTextColumn Header="问题" Binding="{Binding IssueCount}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="暂无匹配结果，请调整搜索词" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ResultsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Border>
                <Border x:Name="Callout" Background="#EDF6FE" BorderBrush="#CBDFEF" BorderThickness="1" CornerRadius="11" Padding="16,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailIcon" Text="ⓘ" Foreground="{StaticResource DiamondBrush}" FontSize="19" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1"><TextBlock x:Name="DetailHeading" Text="诊断与说明" Foreground="{StaticResource DiamondBrush}" FontWeight="SemiBold"/>
                            <TextBox x:Name="DetailText" Text="选择扫描结果可查看诊断。待确认项需要人工检查。" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" MinHeight="45" MaxHeight="110" Margin="0,5,0,0" Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"/></StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

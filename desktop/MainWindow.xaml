<Window x:Class="McServerPackBuilder.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC 服务端整合包助手" Width="1040" Height="700" MinWidth="780" MinHeight="520"
        Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MC 服务端整合包助手" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="扫描模组元数据，辅助判断服务端保留范围" Foreground="#667085" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Padding="9,0" ToolTip="JAR、mods 文件夹、MRPACK 或 ZIP"/>
            <Button Grid.Column="1" Content="选择文件" Click="ChooseFile_Click" Margin="8,0,0,0" Padding="16,0"/>
            <Button Grid.Column="2" Content="选择文件夹" Click="ChooseFolder_Click" Margin="8,0,0,0" Padding="16,0"/>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ScanButton" Content="开始扫描" Click="Scan_Click" Padding="20,8" Background="#2563EB" Foreground="White" BorderThickness="0"/>
                <Button x:Name="BuildButton" Content="制作服务端 ZIP" Click="Build_Click" Padding="16,8" Margin="8,0,0,0"/>
                <Button x:Name="ExportButton" Content="导出 JSON" Click="Export_Click" Padding="16,8" Margin="8,0,0,0" IsEnabled="False"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="选择待扫描内容" VerticalAlignment="Center" Foreground="#475467" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="模组路径" Binding="{Binding Path}" Width="3*"/>
                <DataGridTextColumn Header="服务端判断" Binding="{Binding SideLabel}" Width="1*"/>
                <DataGridTextColumn Header="依据" Binding="{Binding Reason}" Width="3*"/>
                <DataGridTextColumn Header="问题" Binding="{Binding IssueCount}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <GroupBox Grid.Row="4" Header="诊断与说明" Margin="0,12,0,0" Padding="8">
            <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent" Text="选择扫描结果可查看诊断。UNKNOWN 需要人工确认；分类不代表服务端启动验证。"/>
        </GroupBox>
    </Grid>
</Window>
